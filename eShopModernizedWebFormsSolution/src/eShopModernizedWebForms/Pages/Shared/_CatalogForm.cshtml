@model eShopModernizedWebForms.Pages.Catalog.CatalogFormModel
@{ var labelClass = Model.IsEdit ? "control-label col-md-4" : "control-label col-md-2"; var inputClass = Model.IsEdit ? "col-md-8" : "col-md-3"; }
<div class="form-horizontal">
    <div class="form-group">
        <label asp-for="Item.Name" class="@labelClass">Name</label>
        <div class="@inputClass"><input asp-for="Item.Name" class="form-control" /><span asp-validation-for="Item.Name" class="text-danger"></span></div>
    </div>
    <div class="form-group">
        <label asp-for="Item.Description" class="@labelClass">Description</label>
        <div class="@inputClass"><input asp-for="Item.Description" class="form-control" /></div>
    </div>
    <div class="form-group">
        <label asp-for="Item.CatalogBrandId" class="@labelClass">Brand</label>
        <div class="@inputClass"><select asp-for="Item.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select></div>
    </div>
    <div class="form-group">
        <label asp-for="Item.CatalogTypeId" class="@labelClass">Type</label>
        <div class="@inputClass"><select asp-for="Item.CatalogTypeId" asp-items="Model.Types" class="form-control"></select></div>
    </div>
    <div class="form-group">
        <label asp-for="Item.Price" class="@labelClass">Price</label>
        <div class="@inputClass"><input asp-for="Item.Price" type="text" asp-format="{0:0.00}" class="form-control" /><span asp-validation-for="Item.Price" class="text-danger"></span></div>
    </div>
    <div class="form-group">
        <label asp-for="Item.PictureFileName" class="@labelClass">Picture name</label>
        @if (Model.IsEdit)
        {
            <div class="@inputClass"><input asp-for="Item.PictureFileName" readonly title="Not allowed for edition" class="form-control" /></div>
        }
        else
        {
            <div class="col-md-4 esh-form-information">Uploading images not allowed for this version.</div>
        }
    </div>
    <div class="form-group">
        <label asp-for="Item.AvailableStock" class="@labelClass">Stock</label>
        <div class="@inputClass"><input asp-for="Item.AvailableStock" type="text" class="form-control" /><span asp-validation-for="Item.AvailableStock" class="text-danger"></span></div>
    </div>
    <div class="form-group">
        <label asp-for="Item.RestockThreshold" class="@labelClass">Restock</label>
        <div class="@inputClass"><input asp-for="Item.RestockThreshold" type="text" class="form-control" /><span asp-validation-for="Item.RestockThreshold" class="text-danger"></span></div>
    </div>
    <div class="form-group">
        <label asp-for="Item.MaxStockThreshold" class="@labelClass">Max stock</label>
        <div class="@inputClass"><input asp-for="Item.MaxStockThreshold" type="text" class="form-control" /><span asp-validation-for="Item.MaxStockThreshold" class="text-danger"></span></div>
    </div>
    <div class="form-group"><div class="@(Model.IsEdit ? "col-md-12" : "col-md-offset-2 col-md-3") text-right esh-button-actions">
        <a href="/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
        <button type="submit" class="btn esh-button esh-button-primary">[ @(Model.IsEdit ? "Save" : "Create") ]</button>
    </div></div>
</div>

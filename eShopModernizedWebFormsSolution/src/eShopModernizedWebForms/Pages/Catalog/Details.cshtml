@page "{id:int}"
@model eShopModernizedWebForms.Pages.Catalog.DetailsModel
@{
    ViewData["Title"] = "Details";
}

    <h2 class="esh-body-title">Details</h2>

    <div class="container">
        <div class="row">
            <img class="col-md-6 esh-picture" src="/Pics/@Model.Product.PictureFileName" />
            <dl class="col-md-6 dl-horizontal">
                <partial name="_ProductFields" model="Model.Product" />
            </dl>
        </div>

        <div class="form-actions no-color esh-link-list">
            <a href="/Catalog/Edit/@Model.Product.Id" class="esh-link-item">Edit
            </a>
            |
            <a href="/" class="esh-link-item">Back to list
            </a>
        </div>
    </div>

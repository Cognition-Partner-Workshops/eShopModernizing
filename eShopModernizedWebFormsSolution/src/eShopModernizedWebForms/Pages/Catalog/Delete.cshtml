@page "{id:int}"
@model eShopModernizedWebForms.Pages.Catalog.DeleteModel
@{ ViewData["Title"] = "Delete"; }
<h2 class="esh-body-title">Delete</h2>
<div class="container">
    <h3>Are you sure you want to delete this?</h3>
    <partial name="_CatalogDetails" model="Model.Item" />
    <form method="post" class="form-actions no-color">
        <button type="submit" class="btn esh-button esh-button-primary">[ Delete ]</button> |
        <a href="/" class="esh-link-item">Back to list</a>
    </form>
</div>
